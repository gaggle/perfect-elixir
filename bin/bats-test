#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CHECKSUM_DIR="${TMPDIR:-/tmp}"
CHECKSUM_FILE="$CHECKSUM_DIR/perfect-elixir-bats-checksum"

usage() {
  echo "Run Bats tests"
  echo ""
  echo "This script skips running tests if shell scripts or tests have not changed."
  echo "Usage:"
  echo "  bats-test [options] [tests]"
  echo ""
  echo "Options:"
  echo "  -f, --force    Force test execution regardless of checksum"
  echo "  -h, --help     Show this help message"
  echo ""
  echo "Arguments:"
  echo "  tests          Path to test file or directory (optional)"
  echo "                 If not provided, runs all tests in test/"
}

# Parse arguments
FORCE=0
TEST_PATHS=()
while [[ $# -gt 0 ]]; do
  case $1 in
    -f|--force)
      FORCE=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    -*)
      echo "Unknown option: $1"
      usage
      exit 1
      ;;
    *)
      TEST_PATHS+=("$1")
      shift
      ;;
  esac
done

BATS=${_BATS:-bats}
NPROC=${_NPROC:-nproc}

PROCESSING_UNITS=$(eval "$NPROC")
BATS_CMD="$BATS -Tr -j $PROCESSING_UNITS"

if [ ${#TEST_PATHS[@]} -gt 0 ]; then
  echo "Running ${TEST_PATHS[*]} (via $PROCESSING_UNITS parallel jobs)..."
  eval "$BATS_CMD ${TEST_PATHS[*]}"
  exit 0
fi

relevant_files=$(echo -e "$(find "$SCRIPT_DIR" -type f)
$(find "test" -type f \( -name "*.bats" -o -name "*.bash" \))" | sort)

file_checksums=$(echo "$relevant_files" | tr '\n' '\0' | xargs -0 sha256sum | sort)

current_checksum=$(echo "$file_checksums" | sha256sum | cut -d' ' -f1)

if [[ $FORCE -eq 0 ]] && [[ -f "$CHECKSUM_FILE" ]]; then
  stored_checksum=$(cat "$CHECKSUM_FILE")
  if [[ "$current_checksum" == "$stored_checksum" ]]; then
    test_count=$($BATS -cr "test")
    echo "No changes since last test run, skipping ${test_count} tests."
    exit 0
  fi
fi

echo "Running all tests (via $PROCESSING_UNITS parallel jobs)..."
eval "$BATS_CMD test"
echo "$current_checksum" > "$CHECKSUM_FILE"
