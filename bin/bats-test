#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "Run Bats tests"
  echo ""
  echo "Usage:"
  echo "  bats-test [options] [tests]"
  echo ""
  echo "Options:"
  echo "  -h, --help     Show this help message"
  echo ""
  echo "Arguments:"
  echo "  tests          Path to test file or directory (optional)"
  echo "                 If not provided, runs all tests in test/"
}

TEST_PATHS=()
while [[ $# -gt 0 ]]; do
  case $1 in
    -h|--help)
      usage
      exit 0
      ;;
    -*)
      echo "Unknown option: $1"
      usage
      exit 1
      ;;
    *)
      TEST_PATHS+=("$1")
      shift
      ;;
  esac
done

BATS=${_BATS:-bats}
NPROC=${_NPROC:-nproc}

PROCESSING_UNITS=$(eval "$NPROC")
BATS_CMD="$BATS -Tr -j $PROCESSING_UNITS"

if [ ${#TEST_PATHS[@]} -gt 0 ]; then
  echo "Running ${TEST_PATHS[*]} (via $PROCESSING_UNITS parallel jobs)..."
  eval "$BATS_CMD ${TEST_PATHS[*]}"
  exit 0
fi

echo "Running all tests (via $PROCESSING_UNITS parallel jobs)..."
eval "$BATS_CMD test"
